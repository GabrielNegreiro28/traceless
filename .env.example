# Copy this file to .env.local (git-ignored) and fill in the values.
# The Firebase web config identifies the project and is not a secret,
# but keep real values in .env.local only.

# Firebase web app config (Firebase Console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check: reCAPTCHA Enterprise site key (score-based web key)
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# App Check debug token. DEV ONLY. Never commit a real value.
# Put the real value in .env.development.local (git-ignored; Vite loads it only in dev),
# never in .env.local, which production builds also read. Leave it empty here.
# Register it in Firebase Console > App Check > Apps > Manage debug tokens.
# Dev only. Never set this in an env file used for production builds; prefer leaving it empty so the SDK generates a debug token in the browser console.
VITE_APPCHECK_DEBUG_TOKEN=

# AI backend: "real" uses Firebase AI Logic; "fake" uses deterministic fakes (tests, E2E, demo).
VITE_AI_MODE=real

# Local emulators: "true" connects Auth (127.0.0.1:9099) and Firestore (127.0.0.1:8080)
# and switches the project id to demo-traceless. Start them with `npm run emulators`.
VITE_USE_EMULATORS=false
