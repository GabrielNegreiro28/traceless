  "autoMode": {
    "hard_deny": [
      "$defaults",
      "Deleting files or directories by any means (rm, Remove-Item, del, rd, git rm, git clean, node/python scripts calling unlink/rm/rmdir, emptying a file to destroy its content). Exception: package managers and build tools managing their own outputs (node_modules, dist, coverage, caches) during normal install/build/test.",
      "Sending emails, chat messages, or any communication to people (SMTP, Gmail, Slack, Teams, Discord, webhooks, GitHub issue/PR comments or mentions). PushNotification to the owner is allowed.",
      "Making a GitHub repository public or changing its visibility, deleting or archiving remote repositories, deleting Firebase/Google Cloud projects, apps, hosting sites or Firestore data.",
      "Force-pushing or otherwise rewriting published git history.",
      "Committing, pushing, printing or uploading secrets: App Check debug tokens, service-account keys, OAuth tokens, .env.local contents.",
      "Editing Claude Code settings files (.claude/settings.json, .claude/settings.local.json) or disabling hooks, lint rules, type checks or tests to make checks pass."
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  }
