{
  "name": "traceless",
  "version": "0.1.0",
  "private": true,
  "description": "Find the details in a whistleblower report that could reveal who wrote it, on the device, before anything is sent.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-traceless \"vitest run --config vitest.rules.config.ts\"",
    "coverage": "vitest run --coverage",
    "verify:no-debug-token": "node scripts/verify-no-debug-token.mjs",
    "verify:no-eval": "node scripts/verify-no-eval-in-dist.mjs",
    "eval": "vite --open /eval",
    "eval:inspect": "node scripts/eval-inspect.mjs",
    "verify:prod-config": "node scripts/verify-prod-config.mjs",
    "emulators": "firebase emulators:start --project demo-traceless",
    "deploy:hosting": "npm run verify:prod-config && npm run build && firebase deploy --only hosting --project traceless-92f85",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes --project traceless-92f85",
    "deploy:config": "firebase deploy --only remoteconfig --project traceless-92f85",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules,firestore:indexes,remoteconfig --project traceless-92f85",
    "ci": "npm run format:check && npm run lint && npm test && npm run build && npm run verify:no-debug-token && npm run verify:no-eval",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "compromise": "14.20.0",
    "firebase": "13.3.0",
    "lucide-react": "1.60.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "firebase-tools": "15.36.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jsdom": "31.0.0",
    "lint-staged": "17.6.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
